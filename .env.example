# ---- service ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-ebay
SERVICE_VERSION=0.1.0
# GIT_SHA is normally injected by the container build.
# GIT_SHA=unknown
# Public URL advertised in the generated OpenAPI document (required by ChatGPT).
# PUBLIC_BASE_URL=https://ebay-tools.example.com

REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ---- caller authentication (ChatGPT -> connector) --------------------------
# api-key | disabled (disabled is rejected when NODE_ENV=production)
AUTH_MODE=api-key
# Comma separated. Each key must be >= 32 characters.
# This credential is independent of the eBay application credentials below.
API_KEYS=replace-me-with-a-long-random-connector-key

# ---- eBay application credentials (connector -> eBay) ----------------------
# From https://developer.ebay.com -> Application Keys. Use the *production*
# App ID / Cert ID pair with EBAY_ENVIRONMENT=production, or the sandbox pair
# with EBAY_ENVIRONMENT=sandbox. Never commit real values.
EBAY_CLIENT_ID=replace-me-with-your-ebay-app-id
EBAY_CLIENT_SECRET=replace-me-with-your-ebay-cert-id
# production | sandbox
EBAY_ENVIRONMENT=production
# Default marketplace for tools that do not specify one.
EBAY_MARKETPLACE_ID=EBAY_US
# Comma separated OAuth scopes for the client-credentials grant.
EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope
# Renew the cached application token this long before it expires.
EBAY_TOKEN_REFRESH_SKEW_MS=300000
EBAY_MAX_RETRIES=2
EBAY_RETRY_BASE_DELAY_MS=250

# ---- buyer context ---------------------------------------------------------
# eBay only returns shippingOptions for calculated-shipping listings when a
# contextual location is supplied, so setting these materially improves the
# delivered-total figures the connector can report.
# EBAY_DELIVERY_COUNTRY=US
# EBAY_DELIVERY_POSTAL_CODE=19406
# eBay Partner Network campaign id; when set, eBay returns affiliate item URLs.
# EBAY_AFFILIATE_CAMPAIGN_ID=

# ---- result-size guardrails ------------------------------------------------
EBAY_SEARCH_DEFAULT_LIMIT=20
EBAY_SEARCH_MAX_LIMIT=50
EBAY_COMPARE_MAX_ITEMS=8

# ---- opt-in live tests -----------------------------------------------------
# Set to 1 together with real EBAY_CLIENT_ID/EBAY_CLIENT_SECRET to enable the
# live Browse API smoke tests. The default test suite never needs credentials.
# EBAY_LIVE_TESTS=0
