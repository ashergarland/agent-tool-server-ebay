{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "_comment": [
    "Portable, account-neutral baseline for a development deployment. It is an example/default, not",
    "authoritative configuration for any particular operator. See prod.parameters.json for the rules",
    "about external operator files, release-specific values, and Key Vault secrets."
  ],
  "parameters": {
    "environmentName": { "value": "dev" },
    "location": { "value": "westus2" },
    "ebayEnvironment": { "value": "sandbox" },
    "ebayMarketplaceId": { "value": "EBAY_US" },
    "ebayDeliveryCountry": { "value": "US" },
    "ebayDeliveryPostalCode": { "value": "" },
    "logLevel": { "value": "debug" },
    "minReplicas": { "value": 0 },
    "maxReplicas": { "value": 2 },
    "enableHealthAlerts": { "value": false },
    "alertEmails": { "value": [] },
    "alertSmsPhone": { "value": "" },
    "alertSmsCountryCode": { "value": "1" },
    "tags": { "value": {} }
  }
}
