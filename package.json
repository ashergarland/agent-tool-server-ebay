{
  "name": "agent-tool-server-ebay",
  "version": "0.1.0",
  "description": "Read-only agent tool server for searching, retrieving, and comparing active eBay Marketplace listings.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "mcp:stdio": "node dist/mcp/stdio.js",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "metadata:validate": "tsx scripts/validate-metadata.ts",
    "openapi:validate": "vitest run tests/unit/openapi.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashergarland/agent-tool-server-ebay.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.11.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/ashergarland/agent-tool-server-ebay#readme",
  "bugs": {
    "url": "https://github.com/ashergarland/agent-tool-server-ebay/issues"
  },
  "bin": {
    "agent-tool-server-ebay-mcp": "dist/mcp/stdio.js"
  }
}
